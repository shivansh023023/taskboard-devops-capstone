# TaskBoard Environment Configuration
# NOTE: Default development credentials are for local evaluation only and must be replaced in production.

# Database Configuration
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard
POSTGRES_DB=taskboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Database Connection URL (for local host Python/Pytest development on port 5433)
# Note: Inside Docker Compose, the backend container automatically connects via service DNS to 'postgres:5432'.
DATABASE_URL=postgresql+psycopg://taskboard:taskboard@localhost:5433/taskboard

# Backend App Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api
PROJECT_NAME=TaskBoard

# CORS Configuration (comma-separated origins or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://localhost:8000"]
