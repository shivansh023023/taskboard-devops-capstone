# TaskBoard Environment Configuration

# Database Configuration
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard
POSTGRES_DB=taskboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Database Connection URL (compatible with SQLAlchemy and psycopg 3)
# Note: Default port 5433 is used for Docker Compose to avoid conflict with existing local PostgreSQL instances.
DATABASE_URL=postgresql+psycopg://taskboard:taskboard@localhost:5433/taskboard

# Backend App Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api
PROJECT_NAME=TaskBoard

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
